# Server-side only. Never expose this value to browser code.
OPENAI_API_KEY=
OPENAI_CV_EXTRACTION_MODEL=
OPENAI_CANDIDATE_EVALUATION_MODEL=
OPENAI_TIMEOUT_MS=30000

# Deterministic candidate-vacancy technology matching category weights. Values must total 100.
MATCH_REQUIRED_TECHNOLOGY_WEIGHT=70
MATCH_PREFERRED_TECHNOLOGY_WEIGHT=30

# PostgreSQL connection string used only by the API application.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-development-password
POSTGRES_DB=interview_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:local-development-password@localhost:5432/interview_platform?schema=public

# API runtime configuration.
NODE_ENV=development
PORT=3001
# Comma-separated browser origins: HR Shell and the standalone candidate Interview App.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
WEB_APP_URL=http://localhost:3000
# Origin used for candidate interview links (/interview/:token). Defaults to WEB_APP_URL.
INTERVIEW_APP_URL=http://localhost:3002

# SMTP credentials used only by the API to deliver account verification emails.
EMAIL_FROM=AI Interview Platform
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=headrepo@gmail.com
SMTP_PASSWORD=smemopzlgbbeyxhp

# Authentication signing secret. Use a long, randomly generated value locally and in deployment.
AUTH_SECRET=

# Browser-safe public API origin. No secret values may use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000